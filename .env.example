# Serveur Kaza (dépôt kaza-api). Sans ces deux variables, l'application reste en mode local
# (données sur le téléphone, code de démo affiché à l'écran).
# Après modification : relancer avec `npx expo start --clear` (Expo intègre ces valeurs au bundle).

# Téléphone sur le même Wi-Fi que l'ordinateur : l'adresse IP de l'ordinateur, pas localhost
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Clé de l'application (type « default ») : en local, celle créée par `pnpm db:seed` dans kaza-api
EXPO_PUBLIC_API_KEY=local_kazaMobileLocalKey0000001:kazaMobileLocalSecret000000000000000000000000000001
