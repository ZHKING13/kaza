{
  "expo": {
    "name": "Kaza",
    "slug": "kaza",
    "scheme": "kaza",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "africa.kaza.app",
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      }
    },
    "android": {
      "package": "africa.kaza.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F8FAFC",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B1220"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kaza utilise vos photos pour illustrer vos biens.",
          "cameraPermission": "Kaza utilise l'appareil photo pour photographier vos biens.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Kaza lit le contact que vous choisissez pour remplir la fiche du locataire."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E",
          "defaultChannel": "default"
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "updateCriticalIndex": 0,
      "router": {},
      "eas": {
        "projectId": "b60e9bb4-1bec-44d6-85d2-7d2779d45561"
      }
    },
    "owner": "zetreyy"
  }
}
